{
  "manifest_version": 3,
  "name": "eCourse 已登入平台开启器",
  "version": "0.1.11",
  "description": "将 eCourse 维护的 eLearn／eeclass 登录状态安全交接到目前的 Brave 视窗。",
  "key": "",
  "permissions": ["cookies", "tabs"],
  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*",
    "https://elearn.nthu.edu.tw/*",
    "https://eeclass.nthu.edu.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "eCourse 已登入平台开启器"
  }
}
