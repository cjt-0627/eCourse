# Standalone Docker Compose：將此檔案命名為 .env，並和 compose.yaml 放在同一個空目錄。
# docker compose up -d
# 由 GitHub Actions 發布的 multi-arch image（linux/amd64、linux/arm64）。
ECOURSE_IMAGE=ghcr.io/cjt-0627/ecourse:latest
POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_DB=ecourse
POSTGRES_USER=ecourse
# 請替換為至少 32 個字元的 URL-safe 密碼，例如：openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# 維持 local 且只開放 localhost；公開部署請使用 production、HTTPS 網址與精確網域。
ECOURSE_ENV=local
ECOURSE_BASE_URL=http://localhost:8765
ECOURSE_ALLOWED_HOSTS=localhost,127.0.0.1
ECOURSE_PORT=8765

# PostgreSQL、應用程式密鑰與 runtime 均保存在 Docker named volumes。
# 請勿使用 `docker compose down -v`，否則會永久刪除資料與密鑰。
