# 尚不自動載入 .env；請在 shell export。路徑必須為絕對路徑。
# 預設資料位置：~/.local/share/ecourse
# 預設金鑰位置：~/.local/share/ecourse-secrets
# ECOURSE_DATA_DIR=/absolute/path/to/ecourse-data
# ECOURSE_SECRET_DIR=/absolute/path/to/ecourse-secrets
ECOURSE_ENV=local
ECOURSE_BASE_URL=http://localhost:8765
ECOURSE_ALLOWED_HOSTS=localhost,127.0.0.1
# start.command 使用專案內 .data、.secrets 和 .cache/ms-playwright。
# 直接執行 CLI 時，若瀏覽器裝在專案內，請 export：
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/eCourseweb/.cache/ms-playwright
